<Window x:Class="CodexUsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatGPT Codex Usage Widget"
        Width="385" Height="48"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="False"
        Focusable="False" ShowActivated="False" Icon="CodexWidget.ico">
    <Border x:Name="Root" Padding="7,2" Cursor="SizeWE" CornerRadius="7" BorderThickness="1"
            Background="Transparent" BorderBrush="#28FFFFFF">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="MoveLeftMenu" Header="Move to left edge" />
                <MenuItem x:Name="PlaceWeatherMenu" Header="Place beside weather" />
                <MenuItem x:Name="MoveRightMenu" Header="Move to right edge" />
                <MenuItem x:Name="NextDisplayMenu" Header="Move to next display" />
                <MenuItem x:Name="RefreshMenu" Header="Refresh usage" />
                <MenuItem Header="Refresh interval">
                    <MenuItem x:Name="Refresh30Menu" Header="30 seconds" IsCheckable="True" />
                    <MenuItem x:Name="Refresh2MinuteMenu" Header="2 minutes" IsCheckable="True" />
                    <MenuItem x:Name="Refresh5MinuteMenu" Header="5 minutes" IsCheckable="True" />
                    <MenuItem x:Name="RefreshManualMenu" Header="Manual only" IsCheckable="True" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="ContextModeMenu" Header="Context mode">
                    <MenuItem x:Name="ContextDefaultMenu" Header="Default" IsCheckable="True" />
                    <MenuItem x:Name="Context300KMenu" Header="300K" IsCheckable="True" />
                    <MenuItem x:Name="Context600KMenu" Header="600K" IsCheckable="True" />
                    <MenuItem x:Name="Context1MMenu" Header="1M" IsCheckable="True" />
                </MenuItem>
                <MenuItem x:Name="LockPositionMenu" Header="Lock position" IsCheckable="True" />
                <Separator />
                <MenuItem x:Name="ExitMenu" Header="Exit ChatGPT Codex widget" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38" />
                <ColumnDefinition Width="152" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center" ToolTip="Codex usage updated">
                <Ellipse x:Name="StatusPulse" Width="30" Height="30" Fill="#3831D6E4" Opacity="0" />
                <Image Width="23" Height="23" Source="CodexWidget.ico" Stretch="Uniform" />
            </Grid>
            <Grid Grid.Column="1" Margin="1,0,6,0" VerticalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="20" /></Grid.RowDefinitions>
                <TextBlock x:Name="TimeText" Grid.Row="0" Text="WEEKLY · Reset unavailable" Foreground="#FFF0F0F0"
                           FontFamily="Segoe UI Variable Text, Segoe UI" FontWeight="SemiBold" FontSize="10.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="112" Height="7" Background="#4FFFFFFF" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border x:Name="RemainingBar" Width="0" Height="7" Background="#FF70D88B" CornerRadius="3" HorizontalAlignment="Left" />
                    </Border>
                    <TextBlock x:Name="PercentText" Grid.Column="1" Text="--%" Margin="5,0,0,0" Foreground="#FFF3F3F3"
                               FontFamily="Segoe UI Variable Text, Segoe UI" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                </Grid>
            </Grid>
            <Border Grid.Column="2" Width="1" Height="28" Background="#30FFFFFF" VerticalAlignment="Center" />
            <Grid Grid.Column="3" Margin="8,0,2,0" VerticalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="20" /></Grid.RowDefinitions>
                <TextBlock x:Name="ShortTimeText" Grid.Row="0" Text="5 HOURS · Unavailable" Foreground="#FFCFCFCF"
                           FontFamily="Segoe UI Variable Text, Segoe UI" FontWeight="SemiBold" FontSize="10.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="126" Height="7" Background="#4FFFFFFF" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border x:Name="ShortRemainingBar" Width="0" Height="7" Background="#FF5BAEFF" CornerRadius="3" HorizontalAlignment="Left" />
                    </Border>
                    <TextBlock x:Name="ShortPercentText" Grid.Column="1" Text="--%" Margin="5,0,0,0" Foreground="#FFF3F3F3"
                               FontFamily="Segoe UI Variable Text, Segoe UI" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
