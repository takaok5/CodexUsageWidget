<Window x:Class="CodexUsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatGPT Codex Usage Widget"
        Width="430" Height="48"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="False"
        Focusable="False" ShowActivated="False" Icon="CodexWidget.ico">
    <Border x:Name="Root" Padding="7,2" Cursor="SizeWE" CornerRadius="7" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#E81B1B1B" />
                <Setter Property="BorderBrush" Value="#88414141" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F3252525" />
                        <Setter Property="BorderBrush" Value="#CC5B5B5B" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="MoveLeftMenu" Header="Move to left edge" />
                <MenuItem x:Name="PlaceWeatherMenu" Header="Place beside weather" />
                <MenuItem x:Name="MoveRightMenu" Header="Move to right edge" />
                <MenuItem x:Name="NextDisplayMenu" Header="Move to next display" />
                <MenuItem x:Name="RefreshMenu" Header="Refresh usage" />
                <MenuItem x:Name="ContextModeMenu" Header="Codex work mode..." />
                <MenuItem Header="Refresh interval">
                    <MenuItem x:Name="Refresh30Menu" Header="30 seconds" IsCheckable="True" />
                    <MenuItem x:Name="Refresh2MinuteMenu" Header="2 minutes" IsCheckable="True" />
                    <MenuItem x:Name="Refresh5MinuteMenu" Header="5 minutes" IsCheckable="True" />
                    <MenuItem x:Name="RefreshManualMenu" Header="Manual only" IsCheckable="True" />
                </MenuItem>
                <MenuItem x:Name="LockPositionMenu" Header="Lock position" IsCheckable="True" />
                <MenuItem x:Name="AnimateIconMenu" Header="Animate icon" IsCheckable="True" />
                <MenuItem Header="Animation speed">
                    <MenuItem x:Name="AnimationSlowMenu" Header="Slow" IsCheckable="True" />
                    <MenuItem x:Name="AnimationNormalMenu" Header="Normal" IsCheckable="True" />
                    <MenuItem x:Name="AnimationFastMenu" Header="Fast" IsCheckable="True" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="ExitMenu" Header="Exit ChatGPT Codex widget" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="39" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="31" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="IconHost" Width="29" Height="29" Margin="2,0,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="1">
                <Border Background="#FFF2F2F2" CornerRadius="6">
                    <TextBlock Text="C" Foreground="#FF202020" FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image Source="CodexWidget.ico" Width="29" Height="29" Stretch="Uniform" />
            </Grid>
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="21" />
                    <RowDefinition Height="21" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="67" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ChatGPT" Foreground="#FFF8F8F8" FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBlock x:Name="TimeText" Grid.Column="1" Text="Weekly Reset unavailable"
                               Foreground="#FFD5D5D5" FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontWeight="Normal" FontSize="11.5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="67" />
                        <ColumnDefinition Width="108" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Remaining" Margin="0,0,7,0" Foreground="#FFD5D5D5"
                               FontFamily="Segoe UI Variable Text, Segoe UI" FontWeight="SemiBold"
                               FontSize="10.5" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Width="108" Height="7" Background="#666A6A6A"
                            CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border x:Name="RemainingBar" Width="0" Height="7" Background="#FF70D88B"
                                CornerRadius="3" HorizontalAlignment="Left" />
                    </Border>
                    <TextBlock x:Name="PercentText" Grid.Column="2" Text="--%" Margin="8,0,0,0"
                               Foreground="#FFF3F3F3" FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Grid Grid.Column="2" Width="79" Height="38" Margin="4,0"
                  VerticalAlignment="Center" ToolTipService.ShowDuration="30000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="13" />
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TaskbarModeText" Text="DEFAULT" Foreground="#FFD7D7D7"
                           FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="9.5"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border Grid.Row="1" Height="7" Background="#FF4B4B4B" CornerRadius="4" VerticalAlignment="Center" />
                <Grid Grid.Row="1" Margin="6,0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="3" Height="3" Fill="#FFB6B6B6" HorizontalAlignment="Left" />
                    <Ellipse Grid.Column="1" Width="3" Height="3" Fill="#FF8A8A8A" HorizontalAlignment="Center" />
                    <Ellipse Grid.Column="2" Width="3" Height="3" Fill="#FF8A8A8A" HorizontalAlignment="Center" />
                    <Ellipse Grid.Column="3" Width="3" Height="3" Fill="#FF8A8A8A" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="TaskbarModeSlider" Grid.Row="1" Minimum="0" Maximum="3" Value="0" TickFrequency="1"
                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Height="24"
                        FocusVisualStyle="{x:Null}" Cursor="Hand">
                    <Slider.Template>
                        <ControlTemplate TargetType="Slider">
                            <Grid Margin="6,0">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="#FF48A7FF" Height="7" CornerRadius="4" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="18" Height="18">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse x:Name="ThumbCircle" Fill="#FFFFFFFF" Stroke="#22000000" StrokeThickness="1">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.35" />
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbCircle" Property="Fill" Value="#FFF2F8FE" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbCircle" Property="Stroke" Value="#FF48A7FF" />
                                                            <Setter TargetName="ThumbCircle" Property="StrokeThickness" Value="2" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="ThumbCircle" Property="Opacity" Value="0.45" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" Height="7" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Slider.Template>
                </Slider>
            </Grid>

            <Button x:Name="ContextButton" Grid.Column="3" Width="28" Height="30" Padding="0"
                    Background="Transparent" BorderBrush="Transparent" Cursor="Hand"
                    Foreground="#FFD0D0D0" FontFamily="Segoe UI Symbol" FontSize="17"
                    Content="⚡" ToolTip="Choose global or project context target">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF353535" />
                                <Setter Property="Foreground" Value="#FFF4F4F4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF454545" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF48A7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
