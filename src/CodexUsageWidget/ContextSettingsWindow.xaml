<Window x:Class="CodexUsageWidget.ContextSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex context target" Width="332" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Icon="CodexWidget.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF202020" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FF3B3B3B" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF4F4F4" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9C9C9C" />
        <SolidColorBrush x:Key="BlueBrush" Color="#FF48A7FF" />

        <Style x:Key="ScopeButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="6" Padding="9,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF343434" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF3B3B3B" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF343434" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF404040" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFF7F7F7" />
            <Setter Property="Foreground" Value="#FF202020" />
            <Setter Property="BorderBrush" Value="#FF585858" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Margin="8" Padding="13,11,13,12" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.46" Color="#FF000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Advanced" Foreground="{StaticResource MutedBrush}"
                               FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" />
                    <TextBlock Text="›" Margin="5,-1,0,0" Foreground="#FF737373" FontSize="15" />
                </StackPanel>
                <Border Grid.Column="1" Width="25" Height="25" Margin="0,0,3,0"
                        Background="#FF292929" CornerRadius="7">
                    <TextBlock Text="⚡" Foreground="#FFB6B6B6" FontFamily="Segoe UI Symbol" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button x:Name="CloseButton" Grid.Column="2" Content="✕" Width="25" Height="25" FontSize="13"
                        Style="{StaticResource IconButtonStyle}" ToolTip="Close" />
            </Grid>

            <Border Grid.Row="1" Margin="0,9,0,0" Padding="10,8" Background="#FF292929" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ActiveTargetText" Text="Global defaults"
                                   Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Target for the taskbar slider" Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedBrush}" FontSize="10" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock x:Name="ActiveModeText" Text="Default" Foreground="#FF73B9FA"
                                   FontSize="11" FontWeight="SemiBold" TextAlignment="Right" />
                        <TextBlock x:Name="ActiveContextText" Text="Model default" Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,8,0,0" Padding="2" Background="#FF292929" CornerRadius="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="GlobalScopeButton" Content="Global" GroupName="Scope"
                                 IsChecked="True" Style="{StaticResource ScopeButtonStyle}" />
                    <RadioButton x:Name="ProjectScopeButton" Grid.Column="1" Content="Project"
                                 GroupName="Scope" Style="{StaticResource ScopeButtonStyle}" />
                </Grid>
            </Border>

            <StackPanel x:Name="ProjectPanel" Grid.Row="3" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProjectComboBox" Height="31" MaxDropDownHeight="250"
                              DisplayMemberPath="DisplayName" VerticalContentAlignment="Center"
                              ToolTip="Projects read live from the local Codex database" />
                    <Button x:Name="RefreshProjectsButton" Grid.Column="1" Content="↻" Width="31" Height="31"
                            Margin="6,0,0,0" FontSize="15" Style="{StaticResource IconButtonStyle}"
                            ToolTip="Refresh projects" />
                </Grid>
                <CheckBox x:Name="AlsoGlobalCheckBox" Content="Also update global default" Margin="2,6,0,0" />
                <TextBlock x:Name="EmptyProjectsText" Text="No existing projects found in the Codex database."
                           Margin="2,6,0,0" Foreground="#FFFFB76B" FontSize="9.5" Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="4" Margin="1,8,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText" Text="Use the slider in the taskbar to apply a mode."
                           Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" />
                <TextBlock x:Name="ConfigPathText" Grid.Row="1" Margin="0,3,0,0"
                           Foreground="#FF858585" FontFamily="Cascadia Mono, Consolas" FontSize="9"
                           TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="30000" />
            </Grid>
        </Grid>
    </Border>
</Window>
